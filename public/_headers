/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(self), camera=(), payment=()
  Content-Security-Policy: default-src 'self'; script-src 'self' __JSONLD_HASH__; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; object-src 'none'

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/*.html
  Cache-Control: public, max-age=0, must-revalidate

/favicon.svg
  Cache-Control: public, max-age=86400

/og.png
  Cache-Control: public, max-age=86400

/icons/*
  Cache-Control: public, max-age=604800

/site.webmanifest
  Cache-Control: public, max-age=3600
